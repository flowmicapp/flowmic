# C10-3 — after a BRANCH switch, rebuild what the switch just invalidated.
# POSIX sh: husky runs this with `sh -e`, and it must work under a git invoked
# from PowerShell, cmd, git-bash or an editor alike.
#
# git passes: $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout
# and 0 for a FILE checkout. The $3 test is load-bearing: without it every
# `git checkout -- <file>` would run this, and a hook that fires on the command
# people use to undo one file is a hook people uninstall. On `git clone` $1 is
# the all-zero sha, which refresh-derived.mjs treats as "cannot tell" and
# therefore does nothing — a clone's setup is CONTRIBUTING.md's job.
#
# Diff-scoped and silent when nothing moved; it never fails the hook, because
# git ignores this hook's exit status entirely (the checkout already happened) —
# see the header of scripts/refresh-derived.mjs for what it prints instead.
#
# 🔴 `if`, NOT `test && test && cmd`. husky runs this under `sh -e`, where a
# bare AND-list whose first test is false returns 1 and kills the shell — so the
# short form would print "husky - post-checkout script failed (code 1)" on every
# single-file checkout, which is the one case this hook exists to stay out of.
if [ "$3" = "1" ] && [ "$1" != "$2" ]; then
  node scripts/refresh-derived.mjs "$1" "$2"
fi
exit 0
